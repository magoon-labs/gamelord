{
  "name": "@gamelord/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "GameLord desktop application",
  "main": "./out/main/index.mjs",
  "scripts": {
    "build:native": "cd native && node-gyp rebuild",
    "bundle": "electron-vite build",
    "clean": "node -e \"const fs=require('fs');['out','dist'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch{}})\"",
    "build": "npm run clean && npm run build:native && npm run bundle",
    "dev": "electron-vite dev --remote-debugging-port=${CDP_PORT:-9222}",
    "start": "electron-vite preview",
    "package": "npm run build && node ../../tools/packaging/node_modules/electron-builder/cli.js --dir",
    "make": "npm run build && node ../../tools/packaging/node_modules/electron-builder/cli.js",
    "format": "oxfmt --write src/",
    "format:check": "oxfmt --check src/",
    "lint": "oxlint -c ../../oxlint.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@sentry/electron": "^8.3.0",
    "@sentry/react": "11.8.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@gamelord/ui": "workspace:*",
    "@sentry/vite-plugin": "^11.8.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "agent-react-devtools": "^0.5.0",
    "agentation": "^3.0.2",
    "autoprefixer": "^10.6.1",
    "dotenv": "^17.4.2",
    "electron": "45.0.0",
    "electron-vite": "^5.0.0",
    "happy-dom": "^21.0.4",
    "lucide-react": "^1.61.0",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.0.2",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-devtools-core": "^8.0.0",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.0"
  },
  "productName": "GameLord"
}
